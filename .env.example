# GEMINI_API_KEY: Wajib untuk Tutor AI Single-Gateway saat tethering online.
# Dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port server lokal Laptop Guru (default: 3000)
PORT=3000

# HOST_PIN: PIN Keamanan Simpul Guru untuk melindungi otorisasi penerbitan modul dan reset cache (default: 1945)
HOST_PIN="1945"

# RUANGPINTAR_DB_PATH: Path penyimpanan database SQLite lokal di laptop guru
RUANGPINTAR_DB_PATH="./ruangpintar-edge.db"

# APP_URL: URL host (opsional untuk self-referential links bila di-deploy ke Cloud Run)
APP_URL="http://localhost:3000"
